# Copy to .env and adjust. All values have safe demo defaults.
# --- storage --------------------------------------------------------------
# demo:      sqlite:///./paylens_demo.db
# prod:      postgresql+psycopg2://paylens:paylens_dev_password@postgres:5432/paylens
PAYLENS_DATABASE_URL=sqlite:///./paylens_demo.db

# --- event transport ------------------------------------------------------
PAYLENS_EVENT_BUS=memory                # memory | kafka
PAYLENS_KAFKA_BOOTSTRAP=localhost:9092

# --- LLM (optional; hybrid reasoning) ------------------------------------
# none   : deterministic planner + templated narration (no API key needed)
# openai : any OpenAI-compatible endpoint (z.ai, Azure, OpenAI, vLLM, ...)
PAYLENS_LLM_PROVIDER=none
PAYLENS_LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- governed SQL limits --------------------------------------------------
PAYLENS_SQL_MAX_ROWS=20000
PAYLENS_SQL_TIMEOUT=30

# --- demo generator -------------------------------------------------------
PAYLENS_ANCHOR_TS=2026-11-20T23:59:00+00:00
PAYLENS_SEED=42
