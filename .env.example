# Docker Compose binds the API to localhost. These defaults are local-only.
PAYLENS_PG_PASSWORD=paylens_dev_password
PAYLENS_PG_READER_PASSWORD=local_reader_password
PAYLENS_API_TOKEN=local-paylens-only

# External live deployment
# PAYLENS_DATABASE_URL=postgresql+psycopg2://service:...@host/paylens?sslmode=verify-full
# PAYLENS_ANALYTICS_DATABASE_URL=postgresql+psycopg2://reader:...@host/paylens?sslmode=verify-full
# PAYLENS_KAFKA_BOOTSTRAP=broker:9093
# PAYLENS_KAFKA_SECURITY_PROTOCOL=SASL_SSL
# PAYLENS_KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# PAYLENS_KAFKA_USERNAME=
# PAYLENS_KAFKA_PASSWORD=
